  "farmakodynamikk": {
    "tekst": [
      "Antagonist på serotonerge (5-HT_{2A}), alfa-adrenerge, kolinerge, histaminerge og dopaminerge reseptorer. Lav affinitet til D_{1}-, D_{2}-, D_{3}- og D_{5}-reseptorer, men viser høy affinitet til D_{4}-reseptorer."
    ]
  },
  "dosering": {
    "tekst": [
      "Tablett: (12,5) 100–900 mg"
    ]
  },
  "indikasjon": {
    "tekst": [
      "Behandlingsresistent schizofreni, og schizofrene pasienter som ved bruk av andre antipsykotika (inkl. et atypisk antipsykotikum) har fått alvorlige nevrologiske bivirkninger som ikke lar seg behandle.",
      "Psykotiske lidelser ved Parkinsons sykdom, når standardbehandling har sviktet."
    ],
    "referanser": [
      "fk-clozapin-hexal",
      "fk-leponex"
    ]
  },
  "farmakokinetikk": [
    {
      "tittel": "Biotilgjengelighet",
