    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/functions": "^3.9.9",
    "@vitejs/plugin-react": "^4.3.4",
    "supabase": "^2.117.0",
    "typescript": "^5.7.2",
