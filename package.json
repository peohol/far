{
  "name": "far",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "description": "Verktøy for å kommentere farmakologiske analyser",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
